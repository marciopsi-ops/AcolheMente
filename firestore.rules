rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserDoc(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMaster() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               getUserData().role == 'master' ||
               ('roles' in getUserData() && getUserData().roles.hasAny(['master']))
             );
    }

    function isTriagem() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               getUserData().role == 'triagem' ||
               ('roles' in getUserData() && getUserData().roles.hasAny(['triagem']))
             );
    }

    function isProfissional() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               getUserData().role == 'profissional' ||
               ('roles' in getUserData() && getUserData().roles.hasAny(['profissional']))
             );
    }

    // Acolhimentos / Pacientes da Triagem
    match /acolhimentos/{acolhimentoId} {
      allow create, read, update: if true;
      allow delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Triagem Corporativa (Fichas de Bordo do Benefício Corporativo)
    match /triagem_corporativa/{fichaId} {
      allow create, read, update: if true;
      allow delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Acessos e Logs Corporativos
    match /beneficio_acessos/{acessoId} {
      allow create, read, update: if true;
      allow delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Usuários e Perfis da Plataforma
    match /users/{userId} {
      allow read: if true;
      // Usuário comum pode atualizar apenas seu próprio perfil sem se autopromover para master ou triagem
      allow create: if isSignedIn() && (
        isMaster() ||
        (isUserDoc(userId) && request.resource.data.role == 'profissional')
      );
      allow update: if isSignedIn() && (
        isMaster() ||
        (isUserDoc(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles']) || resource.data.role == request.resource.data.role))
      );
      allow delete: if isSignedIn() && isMaster();
    }

    // Leads Profissionais
    match /profissionais_leads/{proId} {
      allow create, read, update, delete: if true;
    }

    // Leads Empresas
    match /empresa_leads/{leadId} {
      allow create, read, update, delete: if true;
    }

    // Doações
    match /doacoes/{doacaoId} {
      allow create, read, update, delete: if true;
    }

    // Solicitações de Doação
    match /solicitacoes_doacao/{solId} {
      allow create, read, update, delete: if true;
    }

    // Configurações Globais da Plataforma
    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Eventos
    match /eventos/{eventoId} {
      allow read, write: if true;
    }

    // Serviços
    match /servicos/{servicoId} {
      allow read, write: if true;
    }

    // Serviços Oferecidos por Profissionais
    match /servicos_profissionais/{servicoId} {
      allow read, write: if true;
    }

    // Inscrições
    match /inscricoes/{inscricaoId} {
      allow create, read, update, delete: if true;
    }

    // Artigos do Blog (Abertos para leitura pública, submissão por profissionais e gestão por master/triagem)
    match /artigos_blog/{artigoId} {
      allow read: if true;
      allow create: if isSignedIn() && (isProfissional() || isMaster() || isTriagem());
      allow update, delete: if isSignedIn() && (isMaster() || isTriagem() || (resource.data.autorUid == request.auth.uid));
    }

    // Compliance / Ouvidoria
    match /compliance/{complianceId} {
      allow create, read, update, delete: if true;
    }

    // Fila de E-mails do Sistema
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Fila de Notificações Agendadas e Histórico de Disparos
    match /notificacoes_agendadas/{notifId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    match /notificacoes_historico/{histId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Alertas de Demanda entre Profissionais (Rede de Conexão)
    match /alertas_demanda/{alertaId} {
      allow read: if true;
      allow create: if isSignedIn() && (isProfissional() || isMaster() || isTriagem());
      allow update, delete: if isSignedIn() && (isMaster() || isTriagem() || (resource.data.autorUid == request.auth.uid));
    }

    // Auditoria de Acessos e Gestão
    match /auditoria_gestao/{auditId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isMaster() || isTriagem());
      allow update, delete: if false;
    }
  }
}
