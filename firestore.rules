rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserDoc(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMaster() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               getUserData().role == 'master' ||
               ('roles' in getUserData() && getUserData().roles.hasAny(['master']))
             );
    }

    function isTriagem() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               getUserData().role == 'triagem' ||
               ('roles' in getUserData() && getUserData().roles.hasAny(['triagem']))
             );
    }

    function isProfissional() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               getUserData().role == 'profissional' ||
               ('roles' in getUserData() && getUserData().roles.hasAny(['profissional']))
             );
    }

    // Acolhimentos / Pacientes da Triagem
    match /acolhimentos/{acolhimentoId} {
      allow create, read, update: if true;
      allow delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Triagem Corporativa (Fichas de Bordo do Benefício Corporativo)
    match /triagem_corporativa/{fichaId} {
      allow create, read, update: if true;
      allow delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Acessos e Logs Corporativos
    match /beneficio_acessos/{acessoId} {
      allow create, read, update: if true;
      allow delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Agendamentos e Sessões da Agenda Profissional
    match /agendamentos/{agendamentoId} {
      allow create, read, update, delete: if true;
    }

    // Pacientes (Unificada - Particulares, Acolhimentos, Externos)
    match /pacientes/{pacienteId} {
      // Listagem isolada: Profissional lista apenas seus próprios pacientes; Master lista apenas acolhimento/particular (nunca externos de terceiros)
      allow list: if (isSignedIn() && resource.data.profissionalId == request.auth.uid) ||
                     (isMaster() && (resource.data.tipo == 'acolhimento' || resource.data.tipo == 'particular'));
      // Leitura individual e atualização por ID único (necessário para links públicos de Atualização Cadastral, Contrato e Faturamento, além da Ficha de Bordo)
      allow get, create, update: if true;
      // Exclusão restrita ao profissional responsável ou Master (exceto carteira externa de terceiros)
      allow delete: if isSignedIn() && (
        resource.data.profissionalId == request.auth.uid ||
        (isMaster() && resource.data.tipo != 'externo')
      );
    }

    // Usuários e Perfis da Plataforma
    match /users/{userId} {
      allow read: if true;
      // Usuário comum pode atualizar apenas seu próprio perfil sem se autopromover para master ou triagem
      allow create: if isSignedIn() && (
        isMaster() ||
        (isUserDoc(userId) && request.resource.data.role == 'profissional')
      );
      allow update: if isSignedIn() && (
        isMaster() ||
        (isUserDoc(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles']) || resource.data.role == request.resource.data.role))
      );
      allow delete: if isSignedIn() && isMaster();
    }

    // Leads Profissionais e Assinaturas Profissionais
    match /profissionais_leads/{proId} {
      allow create, read, update, delete: if true;
    }

    match /profissionais/{profId} {
      allow create, read, update: if true;
      allow delete: if isSignedIn() && isMaster();
    }

    // Leads Empresas
    match /empresa_leads/{leadId} {
      allow create, read, update, delete: if true;
    }

    // Doações
    match /doacoes/{doacaoId} {
      allow create, read, update, delete: if true;
    }

    // Solicitações de Doação
    match /solicitacoes_doacao/{solId} {
      allow create, read, update, delete: if true;
    }

    // Configurações Globais da Plataforma
    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Eventos
    match /eventos/{eventoId} {
      allow read, write: if true;
    }

    // Serviços
    match /servicos/{servicoId} {
      allow read, write: if true;
    }

    // Serviços Oferecidos por Profissionais
    match /servicos_profissionais/{servicoId} {
      allow read, write: if true;
    }

    // Inscrições
    match /inscricoes/{inscricaoId} {
      allow create, read, update, delete: if true;
    }

    // Artigos do Blog (Abertos para leitura pública, submissão por profissionais e gestão por master/triagem)
    match /artigos_blog/{artigoId} {
      allow read: if true;
      allow create: if isSignedIn() && (isProfissional() || isMaster() || isTriagem());
      allow update, delete: if isSignedIn() && (isMaster() || isTriagem() || (resource.data.autorUid == request.auth.uid));
    }

    // Compliance / Ouvidoria
    match /compliance/{complianceId} {
      allow create, read, update, delete: if true;
    }

    // Fila de E-mails do Sistema
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Fila de Notificações Agendadas e Histórico de Disparos
    match /notificacoes_agendadas/{notifId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    match /notificacoes_historico/{histId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    // Alertas de Demanda entre Profissionais (Rede de Conexão)
    match /alertas_demanda/{alertaId} {
      allow read: if true;
      allow create: if isSignedIn() && (isProfissional() || isMaster() || isTriagem());
      allow update, delete: if isSignedIn() && (isMaster() || isTriagem() || (resource.data.autorUid == request.auth.uid));
    }

    // Documentos Psicológicos e Certificados do Profissional
    match /documentos_psicologicos/{docId} {
      allow get: if isValidId(docId);
      allow list: if isSignedIn() && (resource.data.profissionalId == request.auth.uid || isMaster());
      allow create: if isSignedIn() && isValidId(docId) && request.resource.data.profissionalId == request.auth.uid;
      allow update, delete: if isSignedIn() && isValidId(docId) && (resource.data.profissionalId == request.auth.uid || isMaster());
    }

    // Auditoria de Acessos e Gestão
    match /auditoria_gestao/{auditId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isMaster() || isTriagem());
      allow update, delete: if false;
    }

    // Solicitações de Orçamento Corporativo (NR-1, Palestras, Treinamentos)
    match /solicitacoes_orcamentos_corporativos/{solicitacaoId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (isMaster() || isTriagem());
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmpresaProfissional(data) {
      return data.keys().hasAll([
               'profissionalId',
               'nomeFantasia',
               'razaoSocial',
               'cnpj',
               'contatoNome',
               'contatoTelefone',
               'statusComercial'
             ]) &&
             data.keys().hasOnly([
               'profissionalId',
               'profissionalNome',
               'nomeFantasia',
               'razaoSocial',
               'cnpj',
               'inscricaoMunicipal',
               'inscricaoEstadual',
               'ramoAtividade',
               'cep',
               'enderecoCompleto',
               'cidade',
               'uf',
               'contatoNome',
               'contatoCargo',
               'contatoTelefone',
               'contatoEmail',
               'emailFinanceiroNf',
               'condicaoPagamentoPadrao',
               'valorServicoPadrao',
               'statusComercial',
               'perfilFaturamento',
               'perfilFaturamentoId',
               'historicoServicos',
               'registrosBordo',
               'propostaContrato',
               'reajusteAnual',
               'observacoesGerais',
               'createdAt',
               'updatedAt'
             ]) &&
             data.profissionalId is string && data.profissionalId.size() <= 128 &&
             data.profissionalId == request.auth.uid &&
             data.nomeFantasia is string && data.nomeFantasia.size() >= 1 && data.nomeFantasia.size() <= 200 &&
             data.razaoSocial is string && data.razaoSocial.size() <= 250 &&
             data.cnpj is string && data.cnpj.size() <= 30 &&
             data.contatoNome is string && data.contatoNome.size() <= 200 &&
             data.contatoTelefone is string && data.contatoTelefone.size() <= 40 &&
             data.statusComercial in ['ativa_recorrente', 'projeto_pontual', 'prospeccao', 'encerrada'] &&
             (!('profissionalNome' in data) || (data.profissionalNome is string && data.profissionalNome.size() <= 200)) &&
             (!('inscricaoMunicipal' in data) || (data.inscricaoMunicipal is string && data.inscricaoMunicipal.size() <= 60)) &&
             (!('inscricaoEstadual' in data) || (data.inscricaoEstadual is string && data.inscricaoEstadual.size() <= 60)) &&
             (!('ramoAtividade' in data) || (data.ramoAtividade is string && data.ramoAtividade.size() <= 150)) &&
             (!('cep' in data) || (data.cep is string && data.cep.size() <= 20)) &&
             (!('enderecoCompleto' in data) || (data.enderecoCompleto is string && data.enderecoCompleto.size() <= 400)) &&
             (!('cidade' in data) || (data.cidade is string && data.cidade.size() <= 120)) &&
             (!('uf' in data) || (data.uf is string && data.uf.size() <= 10)) &&
             (!('contatoCargo' in data) || (data.contatoCargo is string && data.contatoCargo.size() <= 150)) &&
             (!('contatoEmail' in data) || (data.contatoEmail is string && data.contatoEmail.size() <= 200)) &&
             (!('emailFinanceiroNf' in data) || (data.emailFinanceiroNf is string && data.emailFinanceiroNf.size() <= 200)) &&
             (!('condicaoPagamentoPadrao' in data) || (data.condicaoPagamentoPadrao is string && data.condicaoPagamentoPadrao.size() <= 200)) &&
             (!('valorServicoPadrao' in data) || (data.valorServicoPadrao is number && data.valorServicoPadrao >= 0)) &&
             (!('perfilFaturamento' in data) || (data.perfilFaturamento in ['PF', 'PJ'])) &&
             (!('perfilFaturamentoId' in data) || (data.perfilFaturamentoId is string && data.perfilFaturamentoId.size() <= 128)) &&
             (!('historicoServicos' in data) || (data.historicoServicos is list && data.historicoServicos.size() <= 500)) &&
             (!('registrosBordo' in data) || (data.registrosBordo is list && data.registrosBordo.size() <= 500)) &&
             (!('propostaContrato' in data) || (data.propostaContrato is map && data.propostaContrato.keys().size() <= 20)) &&
             (!('reajusteAnual' in data) || (data.reajusteAnual is map && data.reajusteAnual.keys().size() <= 15)) &&
             (!('observacoesGerais' in data) || (data.observacoesGerais is string && data.observacoesGerais.size() <= 5000));
    }

    // Carteira Privada de Empresas Clientes B2B do Profissional (Isolamento estrito por profissionalId)
    match /empresas_profissional/{empresaId} {
      allow list: if isSignedIn() && resource.data.profissionalId == request.auth.uid;
      allow get, delete: if isSignedIn() && isValidId(empresaId) && resource.data.profissionalId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(empresaId) &&
                       isValidEmpresaProfissional(request.resource.data) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn() &&
                       isValidId(empresaId) &&
                       isValidEmpresaProfissional(request.resource.data) &&
                       resource.data.profissionalId == request.auth.uid &&
                       request.resource.data.profissionalId == resource.data.profissionalId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'profissionalNome',
                         'nomeFantasia',
                         'razaoSocial',
                         'cnpj',
                         'inscricaoMunicipal',
                         'inscricaoEstadual',
                         'ramoAtividade',
                         'cep',
                         'enderecoCompleto',
                         'cidade',
                         'uf',
                         'contatoNome',
                         'contatoCargo',
                         'contatoTelefone',
                         'contatoEmail',
                         'emailFinanceiroNf',
                         'condicaoPagamentoPadrao',
                         'valorServicoPadrao',
                         'statusComercial',
                         'perfilFaturamento',
                         'perfilFaturamentoId',
                         'historicoServicos',
                         'registrosBordo',
                         'propostaContrato',
                         'reajusteAnual',
                         'observacoesGerais',
                         'updatedAt'
                       ]);
    }
  }
}
