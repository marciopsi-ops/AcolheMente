{
  "entities": {
    "Acolhimento": {
      "title": "Acolhimento",
      "description": "Formulário de triagem enviado pelos pacientes.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "viaAcesso": { "type": "string", "enum": ["Particular", "Corporativo"] },
        "empresa": { "type": "string" },
        "fonteRenda": { "type": "string" },
        "faixaSalarial": { "type": "string" },
        "dependentes": { "type": "string" },
        "planoSaude": { "type": "string" },
        "escolaridade": { "type": "string" },
        "moradia": { "type": "string" },
        "comodos": { "type": "string" },
        "internet": { "type": "string" },
        "dispositivo": { "type": "string" },
        "terapiaAnterior": { "type": "string" },
        "motivo": { "type": "string" },
        "status": { "type": "string", "enum": ["Aguardando Avaliação", "Triado"] },
        "valorRef": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["nome", "email", "viaAcesso", "motivo", "createdAt", "status"]
    },
    "ServicoProfissional": {
      "title": "ServicoProfissional",
      "description": "Serviços específicos ofertados e cadastrados por profissionais.",
      "type": "object",
      "properties": {
        "profissionalId": { "type": "string" },
        "profissionalNome": { "type": "string" },
        "nome": { "type": "string" },
        "publicoAlvo": { "type": "string", "enum": ["Para pessoas", "Para Psicólogos", "Para Psicólogos e Terapeutas", "Para Empresas"] },
        "orcamentoAcessivel": { "type": "boolean" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["profissionalId", "profissionalNome", "nome", "publicoAlvo", "orcamentoAcessivel", "createdAt"]
    },
    "Inscricao": {
      "title": "Inscricao",
      "description": "Inscrições enviadas por visitantes para eventos ou serviços.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemTitulo": { "type": "string" },
        "itemTipo": { "type": "string", "enum": ["evento", "servico"] },
        "criadorId": { "type": "string" },
        "nomeCompleto": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "profissao": { "type": "string" },
        "mensagem": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["itemId", "itemTitulo", "itemTipo", "nomeCompleto", "whatsapp", "email", "profissao", "createdAt"]
    },
    "Agendamento": {
      "title": "Agendamento",
      "description": "Sessões e agendamentos clínicos da agenda do profissional com suporte a horários fixos e indicadores.",
      "type": "object",
      "properties": {
        "profissionalId": { "type": "string" },
        "pacienteId": { "type": "string" },
        "pacienteNome": { "type": "string" },
        "pacienteTelefone": { "type": "string" },
        "data": { "type": "string" },
        "horario": { "type": "string" },
        "duracaoMinutos": { "type": "number" },
        "modalidade": { "type": "string", "enum": ["online", "presencial"] },
        "status": { "type": "string", "enum": ["agendada", "realizada", "remarcada", "cancelada"] },
        "valor": { "type": "number" },
        "isHorarioFixo": { "type": "boolean" },
        "observacoes": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["profissionalId", "pacienteId", "pacienteNome", "data", "horario", "status", "createdAt"]
    },
    "ArtigoBlog": {
      "title": "ArtigoBlog",
      "description": "Artigos e publicações informativas submetidos por profissionais e abertos para leitura pública.",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "resumo": { "type": "string" },
        "conteudo": { "type": "string" },
        "conteudoHtml": { "type": "string" },
        "autorNome": { "type": "string" },
        "autorUid": { "type": "string" },
        "autorProfissao": { "type": "string" },
        "autorFoto": { "type": "string" },
        "palavrasChave": { "type": "array", "items": { "type": "string" } },
        "categoria": { "type": "string" },
        "capaUrl": { "type": "string" },
        "tempoLeitura": { "type": "string" },
        "status": { "type": "string", "enum": ["publicado", "rascunho"] },
        "visualizacoes": { "type": "number" },
        "curtidas": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["titulo", "conteudo", "autorNome", "palavrasChave", "createdAt"]
    },
    "NotificacaoAgendada": {
      "title": "NotificacaoAgendada",
      "description": "Mensagens programadas com atraso para disparo via régua de comunicação.",
      "type": "object",
      "properties": {
        "triggerId": { "type": "string" },
        "triggerName": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "recipientName": { "type": "string" },
        "subject": { "type": "string" },
        "emailBody": { "type": "string" },
        "whatsappText": { "type": "string" },
        "scheduledFor": { "type": "string" },
        "delayMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["pendente", "enviado", "erro", "cancelado"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["triggerId", "triggerName", "status", "scheduledFor", "createdAt"]
    },
    "TriagemCorporativa": {
      "title": "TriagemCorporativa",
      "description": "Fichas de bordo geradas no fluxo corporativo quando o colaborador solicita acolhimento.",
      "type": "object",
      "properties": {
        "colaboradorNome": { "type": "string" },
        "colaboradorWhatsapp": { "type": "string" },
        "empresaId": { "type": "string" },
        "empresaNome": { "type": "string" },
        "cargoId": { "type": "string" },
        "cargoNome": { "type": "string" },
        "beneficiarioTipo": { "type": "string", "enum": ["titular", "dependente"] },
        "dependenteInfo": { "type": "string" },
        "dependenteParentesco": { "type": "string" },
        "servicoId": { "type": "string" },
        "servicoNome": { "type": "string" },
        "turnoPreferencia": { "type": "string" },
        "queixa": { "type": "string" },
        "valorSessao": { "type": "number" },
        "frequenciaRecomendada": { "type": "string" },
        "profissionalId": { "type": "string" },
        "profissionalNome": { "type": "string" },
        "status": { "type": "string", "enum": ["solicitacao_servico", "paciente", "alta", "interrupcao"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["colaboradorNome", "colaboradorWhatsapp", "empresaId", "servicoId", "profissionalId", "status", "createdAt"]
    },
    "AuditoriaGestao": {
      "title": "AuditoriaGestao",
      "description": "Registros de ações de apoio de acesso e auditoria de credenciais.",
      "type": "object",
      "properties": {
        "tipo": { "type": "string" },
        "usuarioAlvoUid": { "type": "string" },
        "usuarioAlvoEmail": { "type": "string" },
        "usuarioAlvoNome": { "type": "string" },
        "emailAnterior": { "type": "string" },
        "emailNovo": { "type": "string" },
        "justificativa": { "type": "string" },
        "executadoPorUid": { "type": "string" },
        "executadoPorEmail": { "type": "string" },
        "executadoPorNome": { "type": "string" },
        "data": { "type": "timestamp" }
      },
      "required": ["tipo", "usuarioAlvoUid", "executadoPorUid", "data"]
    },
    "EmpresaLead": {
      "title": "EmpresaLead",
      "description": "Cadastro e ficha de bordo comercial de empresas parceiras, canais de benefícios e clientes conectadas.",
      "type": "object",
      "properties": {
        "nomeEmpresa": { "type": "string" },
        "razaoSocial": { "type": "string" },
        "cnpj": { "type": "string" },
        "categoria": { "type": "string", "enum": ["empresa_direta", "canal_parceiro", "empresa_conectada"] },
        "canalAtivaColaboradoresProprios": { "type": "boolean" },
        "empresaPaiId": { "type": "string" },
        "empresaPaiNome": { "type": "string" },
        "ramoAtividade": { "type": "string" },
        "local": { "type": "string" },
        "colaboradores": { "type": "string" },
        "quantidadeVidas": { "type": "string" },
        "email": { "type": "string" },
        "telefone": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["nomeEmpresa", "cnpj", "createdAt"]
    },
    "SolicitacaoOrcamento": {
      "title": "SolicitacaoOrcamento",
      "description": "Registro de solicitação de orçamento de intervenção corporativa, palestra ou laudo NR-1 enviado pela empresa cliente.",
      "type": "object",
      "properties": {
        "empresaId": { "type": "string" },
        "empresaNome": { "type": "string" },
        "catalogoItemId": { "type": "string" },
        "catalogoItemTitulo": { "type": "string" },
        "contatoNome": { "type": "string" },
        "contatoEmail": { "type": "string" },
        "contatoTelefone": { "type": "string" },
        "vidasEstimadas": { "type": "number" },
        "formatoDesejado": { "type": "string", "enum": ["online", "presencial", "hibrido"] },
        "urgencia": { "type": "string", "enum": ["normal", "alta", "imediata"] },
        "status": { "type": "string", "enum": ["novo", "em_analise", "orcamento_enviado", "contratado", "arquivado"] },
        "dataSolicitacao": { "type": "string" }
      },
      "required": ["empresaId", "catalogoItemId", "contatoNome", "contatoEmail", "status", "dataSolicitacao"]
    },
    "Paciente": {
      "title": "Paciente",
      "description": "Cadastro e prontuário de pacientes da carteira externa particular, acolhimento ou acompanhamento clínico.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "nomeCivil": { "type": "string" },
        "nomeSocial": { "type": "string" },
        "nomeDesejado": { "type": "string" },
        "email": { "type": "string" },
        "telefone": { "type": "string" },
        "dataNascimento": { "type": "string" },
        "cpf": { "type": "string" },
        "genero": { "type": "string" },
        "profissao": { "type": "string" },
        "isMenorIdade": { "type": "boolean" },
        "cep": { "type": "string" },
        "logradouro": { "type": "string" },
        "numero": { "type": "string" },
        "complemento": { "type": "string" },
        "bairro": { "type": "string" },
        "cidade": { "type": "string" },
        "uf": { "type": "string" },
        "enderecoCompleto": { "type": "string" },
        "queixaPrincipal": { "type": "string" },
        "motivo": { "type": "string" },
        "terapiaAnterior": { "type": "string" },
        "medicacao": { "type": "string" },
        "contatoEmergencia": { "type": "string" },
        "modalidade": { "type": "string" },
        "turnoPreferido": { "type": "string" },
        "fonteIndicacao": { "type": "string" },
        "valorSessao": { "type": "string" },
        "frequenciaSessoes": { "type": "string" },
        "tipo": { "type": "string", "enum": ["externo", "particular", "acolhimento"] },
        "viaAcesso": { "type": "string", "enum": ["Carteira Externa", "Triagem Acessível", "Corporativo", "Particular"] },
        "profissionalId": { "type": "string" },
        "status": { "type": "string" },
        "statusTratamento": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["nome", "tipo", "profissionalId"]
    }
  },
  "firestore": {
    "empresa_leads": {
      "schema": { "$ref": "#/entities/EmpresaLead" },
      "description": "Controle corporativo de empresas clientes diretas, canais de benefícios e empresas conectadas."
    },
    "acolhimentos": {
      "schema": { "$ref": "#/entities/Acolhimento" },
      "description": "Coleção de registros de acolhimento (público mas seguro para criação)."
    },
    "triagem_corporativa": {
      "schema": { "$ref": "#/entities/TriagemCorporativa" },
      "description": "Fichas de bordo corporativas para fluxo de acolhimento conveniado."
    },
    "pacientes": {
      "schema": { "$ref": "#/entities/Paciente" },
      "description": "Coleção de pacientes particulares e da carteira externa com isolamento por profissionalId."
    },
    "agendamentos": {
      "schema": { "$ref": "#/entities/Agendamento" },
      "description": "Sessões e agendamentos clínicos da agenda do profissional."
    },
    "servicos_profissionais": {
      "schema": { "$ref": "#/entities/ServicoProfissional" },
      "description": "Serviços cadastrados por profissionais individuais."
    },
    "inscricoes": {
      "schema": { "$ref": "#/entities/Inscricao" },
      "description": "Inscrições enviadas por visitantes para eventos ou serviços."
    },
    "artigos_blog": {
      "schema": { "$ref": "#/entities/ArtigoBlog" },
      "description": "Artigos públicos submetidos por profissionais de saúde e psicologia."
    },
    "notificacoes_agendadas": {
      "schema": { "$ref": "#/entities/NotificacaoAgendada" },
      "description": "Fila de mensagens agendadas para envio posterior."
    },
    "auditoria_gestao": {
      "schema": { "$ref": "#/entities/AuditoriaGestao" },
      "description": "Logs e trilha de auditoria para ações de apoio e segurança de acesso."
    },
    "solicitacoes_orcamentos_corporativos": {
      "schema": { "$ref": "#/entities/SolicitacaoOrcamento" },
      "description": "Pedidos de orçamento enviados por empresas via Portal do RH para serviços de NR-1, GRO/PGR e palestras."
    }
  }
}
