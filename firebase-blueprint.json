{
  "entities": {
    "Acolhimento": {
      "title": "Acolhimento",
      "description": "Formulário de triagem enviado pelos pacientes.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "viaAcesso": { "type": "string", "enum": ["Particular", "Corporativo"] },
        "empresa": { "type": "string" },
        "fonteRenda": { "type": "string" },
        "faixaSalarial": { "type": "string" },
        "dependentes": { "type": "string" },
        "planoSaude": { "type": "string" },
        "escolaridade": { "type": "string" },
        "moradia": { "type": "string" },
        "comodos": { "type": "string" },
        "internet": { "type": "string" },
        "dispositivo": { "type": "string" },
        "terapiaAnterior": { "type": "string" },
        "motivo": { "type": "string" },
        "status": { "type": "string", "enum": ["Aguardando Avaliação", "Triado"] },
        "valorRef": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["nome", "email", "viaAcesso", "motivo", "createdAt", "status"]
    },
    "ServicoProfissional": {
      "title": "ServicoProfissional",
      "description": "Serviços específicos ofertados e cadastrados por profissionais.",
      "type": "object",
      "properties": {
        "profissionalId": { "type": "string" },
        "profissionalNome": { "type": "string" },
        "nome": { "type": "string" },
        "publicoAlvo": { "type": "string", "enum": ["Para pessoas", "Para Psicólogos", "Para Psicólogos e Terapeutas", "Para Empresas"] },
        "orcamentoAcessivel": { "type": "boolean" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["profissionalId", "profissionalNome", "nome", "publicoAlvo", "orcamentoAcessivel", "createdAt"]
    },
    "Inscricao": {
      "title": "Inscricao",
      "description": "Inscrições enviadas por visitantes para eventos ou serviços.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemTitulo": { "type": "string" },
        "itemTipo": { "type": "string", "enum": ["evento", "servico"] },
        "criadorId": { "type": "string" },
        "nomeCompleto": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "profissao": { "type": "string" },
        "mensagem": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["itemId", "itemTitulo", "itemTipo", "nomeCompleto", "whatsapp", "email", "profissao", "createdAt"]
    },
    "ArtigoBlog": {
      "title": "ArtigoBlog",
      "description": "Artigos e publicações informativas submetidos por profissionais e abertos para leitura pública.",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "resumo": { "type": "string" },
        "conteudo": { "type": "string" },
        "conteudoHtml": { "type": "string" },
        "autorNome": { "type": "string" },
        "autorUid": { "type": "string" },
        "autorProfissao": { "type": "string" },
        "autorFoto": { "type": "string" },
        "palavrasChave": { "type": "array", "items": { "type": "string" } },
        "categoria": { "type": "string" },
        "capaUrl": { "type": "string" },
        "tempoLeitura": { "type": "string" },
        "status": { "type": "string", "enum": ["publicado", "rascunho"] },
        "visualizacoes": { "type": "number" },
        "curtidas": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["titulo", "conteudo", "autorNome", "palavrasChave", "createdAt"]
    },
    "NotificacaoAgendada": {
      "title": "NotificacaoAgendada",
      "description": "Mensagens programadas com atraso para disparo via régua de comunicação.",
      "type": "object",
      "properties": {
        "triggerId": { "type": "string" },
        "triggerName": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "recipientName": { "type": "string" },
        "subject": { "type": "string" },
        "emailBody": { "type": "string" },
        "whatsappText": { "type": "string" },
        "scheduledFor": { "type": "string" },
        "delayMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["pendente", "enviado", "erro", "cancelado"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["triggerId", "triggerName", "status", "scheduledFor", "createdAt"]
    },
    "TriagemCorporativa": {
      "title": "TriagemCorporativa",
      "description": "Fichas de bordo geradas no fluxo corporativo quando o colaborador solicita acolhimento.",
      "type": "object",
      "properties": {
        "colaboradorNome": { "type": "string" },
        "colaboradorWhatsapp": { "type": "string" },
        "empresaId": { "type": "string" },
        "empresaNome": { "type": "string" },
        "cargoId": { "type": "string" },
        "cargoNome": { "type": "string" },
        "beneficiarioTipo": { "type": "string", "enum": ["titular", "dependente"] },
        "dependenteInfo": { "type": "string" },
        "dependenteParentesco": { "type": "string" },
        "servicoId": { "type": "string" },
        "servicoNome": { "type": "string" },
        "turnoPreferencia": { "type": "string" },
        "queixa": { "type": "string" },
        "valorSessao": { "type": "number" },
        "frequenciaRecomendada": { "type": "string" },
        "profissionalId": { "type": "string" },
        "profissionalNome": { "type": "string" },
        "status": { "type": "string", "enum": ["solicitacao_servico", "paciente", "alta", "interrupcao"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["colaboradorNome", "colaboradorWhatsapp", "empresaId", "servicoId", "profissionalId", "status", "createdAt"]
    },
    "AuditoriaGestao": {
      "title": "AuditoriaGestao",
      "description": "Registros de ações de apoio de acesso e auditoria de credenciais.",
      "type": "object",
      "properties": {
        "tipo": { "type": "string" },
        "usuarioAlvoUid": { "type": "string" },
        "usuarioAlvoEmail": { "type": "string" },
        "usuarioAlvoNome": { "type": "string" },
        "emailAnterior": { "type": "string" },
        "emailNovo": { "type": "string" },
        "justificativa": { "type": "string" },
        "executadoPorUid": { "type": "string" },
        "executadoPorEmail": { "type": "string" },
        "executadoPorNome": { "type": "string" },
        "data": { "type": "timestamp" }
      },
      "required": ["tipo", "usuarioAlvoUid", "executadoPorUid", "data"]
    }
  },
  "firestore": {
    "acolhimentos": {
      "schema": { "$ref": "#/entities/Acolhimento" },
      "description": "Coleção de registros de acolhimento (público mas seguro para criação)."
    },
    "triagem_corporativa": {
      "schema": { "$ref": "#/entities/TriagemCorporativa" },
      "description": "Fichas de bordo corporativas para fluxo de acolhimento conveniado."
    },
    "servicos_profissionais": {
      "schema": { "$ref": "#/entities/ServicoProfissional" },
      "description": "Serviços cadastrados por profissionais individuais."
    },
    "inscricoes": {
      "schema": { "$ref": "#/entities/Inscricao" },
      "description": "Inscrições enviadas por visitantes para eventos ou serviços."
    },
    "artigos_blog": {
      "schema": { "$ref": "#/entities/ArtigoBlog" },
      "description": "Artigos públicos submetidos por profissionais de saúde e psicologia."
    },
    "notificacoes_agendadas": {
      "schema": { "$ref": "#/entities/NotificacaoAgendada" },
      "description": "Fila de mensagens agendadas para envio posterior."
    },
    "auditoria_gestao": {
      "schema": { "$ref": "#/entities/AuditoriaGestao" },
      "description": "Logs e trilha de auditoria para ações de apoio e segurança de acesso."
    }
  }
}
